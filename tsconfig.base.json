{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@a2arium/callagent-core": [
        "packages/core/src"
      ],
      "@a2arium/callagent-core/*": [
        "packages/core/src/*"
      ],
      "@a2arium/callagent-memory-engine": [
        "packages/memory-engine/src"
      ],
      "@a2arium/callagent-memory-engine/*": [
        "packages/memory-engine/src/*"
      ],
      "@a2arium/callagent-memory-sql": [
        "packages/memory-sql/src"
      ],
      "@a2arium/callagent-memory-sql/*": [
        "packages/memory-sql/src/*"
      ],
      "@a2arium/callagent-types": [
        "packages/types/src"
      ],
      "@a2arium/callagent-types/*": [
        "packages/types/src/*"
      ],
      "@a2arium/callagent-utils": [
        "packages/utils/src"
      ],
      "@a2arium/callagent-utils/*": [
        "packages/utils/src/*"
      ],
      "@a2arium/callagent-chat-bridge": [
        "packages/chat-bridge/src"
      ],
      "@a2arium/callagent-chat-bridge/*": [
        "packages/chat-bridge/src/*"
      ]
    }
  }
}