{
  "name": "callagent",
  "version": "0.3.0",
  "description": "AI Agents Framework with A2A Support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/sync-dotenv.cjs",
    "build": "yarn turbo run build",
    "generate:prisma": "npx prisma generate --schema=packages/memory-sql/prisma/schema.prisma && npx prisma generate --schema=packages/chat-bridge/prisma/schema.prisma && npx prisma generate --schema=packages/core/prisma/schema.prisma",
    "start": "node packages/core/dist/runner/runnerCli.js",
    "dev": "node --loader ts-node/esm packages/core/src/runner/runnerCli.ts",
    "run-agent": "yarn build && node packages/core/dist/runner/runnerCli.js",
    "test": "node --preserve-symlinks --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:coverage": "COVERAGE=true node --preserve-symlinks --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "create-agent": "node packages/core/dist/scaffold/scaffoldCli.js",
    "run:hello": "yarn run-agent apps/examples/hello-agent/dist/agent.js '{\"value\": \"hello\"}'",
    "run:hello-no-deps": "yarn run-agent apps/examples/hello-agent/dist/agent.js '{\"value\": \"hello\"}' --no-resolve-deps",
    "input": "node packages/core/dist/runner/runnerCli.js input",
    "agent-cache": "yarn build && node packages/core/dist/runner/cacheCli.js",
    "agent-index": "yarn build && node packages/core/dist/runner/agentsCli.js index",
    "agent-index:fast": "node packages/core/dist/runner/agentsCli.js index",
    "cache:cleanup": "yarn agent-cache cleanup",
    "cache:stats": "yarn agent-cache stats",
    "cache:clear": "yarn agent-cache clear",
    "clean": "node scripts/clean-generated.cjs",
    "publish:prepare": "yarn build && yarn test",
    "publish:packages": "yarn workspaces run npm:publish",
    "publish:dry-run": "yarn workspaces run npm:publish:dry-run",
    "version:patch": "yarn workspaces run version:patch",
    "version:minor": "yarn workspaces run version:minor",
    "version:major": "yarn workspaces run version:major"
  },
  "keywords": [
    "ai",
    "agent",
    "framework"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "ISC",
  "devDependencies": {
    "@jest/test-sequencer": "29.7.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "ngrok": "^5.0.0-beta.2",
    "prisma": "^7.4.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/examples/*"
  ],
  "resolutions": {
    "uuid": "10.0.0",
    "prisma": "7.4.0",
    "@prisma/client": "7.4.0"
  },
  "private": true,
  "packageManager": "yarn@4.9.4"
}
