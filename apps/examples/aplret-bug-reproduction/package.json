{
  "name": "aplret-bug-reproduction",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/BugReproAgent.js",
  "description": "Minimal reproduction of critical APLRET framework bugs",
  "dependencies": {
    "@a2arium/callagent-core": "workspace:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:vars": "yarn build && ../../node_modules/.bin/tsx ../../packages/core/src/runner/runnerCli.ts --agentPath=dist/BugReproAgent.js --input='{\"testMode\":\"test-vars\"}'",
    "test:a2a": "yarn build && ../../node_modules/.bin/tsx ../../packages/core/src/runner/runnerCli.ts --agentPath=dist/BugReproAgent.js --input='{\"testMode\":\"test-a2a\"}'",
    "test:both": "yarn build && ../../node_modules/.bin/tsx ../../packages/core/src/runner/runnerCli.ts --agentPath=dist/BugReproAgent.js --input='{\"testMode\":\"test-both\"}'",
    "test:api": "yarn build && ../../node_modules/.bin/tsx ../../packages/core/src/runner/runnerCli.ts --agentPath=dist/BugReproAgent.js --input='{\"testMode\":\"test-api\"}'"
  }
}
