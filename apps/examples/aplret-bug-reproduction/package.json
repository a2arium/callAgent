{
  "name": "aplret-bug-reproduction",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/BugReproAgent.js",
  "description": "Minimal reproduction of critical APLRET framework bugs",
  "dependencies": {
    "@a2arium/callagent-core": "workspace:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:vars": "yarn build && callagent run dist/BugReproAgent.js '{\"mode\":\"test-vars\"}'",
    "test:a2a": "yarn build && callagent run dist/BugReproAgent.js '{\"mode\":\"test-a2a\"}'",
    "test:both": "yarn build && callagent run dist/BugReproAgent.js '{\"mode\":\"test-both\"}'"
  }
}
