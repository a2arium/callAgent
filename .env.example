OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

MEMORY_DATABASE_URL="postgresql://username:password@localhost:5432/db"

# Observer named-user authentication
CALLAGENT_PUBLIC_URL="http://127.0.0.1:8790"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
CALLAGENT_OPERATOR_BOOTSTRAP_EMAIL="admin@callagent.local"
CALLAGENT_OPERATOR_BOOTSTRAP_TENANT_ID="default"
# Optional: omit to print a random one-hour temporary password once at startup.
# CALLAGENT_OPERATOR_BOOTSTRAP_PASSWORD=""

LOG_LEVEL=warn
