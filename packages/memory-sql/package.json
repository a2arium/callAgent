{
  "name": "@a2arium/callagent-memory-sql",
  "version": "0.2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "./scripts/setup-database.cjs",
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations",
    "scripts/setup-database.cjs",
    "scripts/optimize-tenant-queries.sql",
    "scripts/semantic-tags-doctor.mjs",
    "scripts/semantic-tags-backfill.mjs"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "rm -rf dist && yarn prisma:generate && tsc -p tsconfig.json && mkdir -p dist/generated/prisma && cp -R src/generated/prisma/* dist/generated/prisma/ && find dist/generated/prisma -name '*.ts' ! -name '*.d.ts' -delete",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:tags:doctor": "node scripts/semantic-tags-doctor.mjs",
    "db:tags:backfill": "node scripts/semantic-tags-backfill.mjs",
    "db:setup-vectors": "tsx scripts/setup-vectors.ts",
    "db:setup": "yarn db:migrate && yarn db:generate && yarn db:setup-vectors",
    "db:reset": "prisma migrate reset && yarn db:setup",
    "db:dev": "prisma migrate dev && yarn db:setup-vectors",
    "print-conversation": "tsx scripts/print-conversation-messages.ts",
    "npm:publish": "npm publish --access public",
    "npm:publish:dry-run": "npm publish --access public --dry-run",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "SQL-backed memory adapter for the CallAgent framework.",
  "license": "MIT",
  "author": "A2arium <a2arium@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2arium/callAgent.git",
    "directory": "packages/memory-sql"
  },
  "bugs": {
    "url": "https://github.com/a2arium/callAgent/issues"
  },
  "homepage": "https://github.com/a2arium/callAgent/tree/main/packages/memory-sql#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "memory",
    "sql",
    "prisma",
    "callagent"
  ],
  "dependencies": {
    "@a2arium/callagent-types": "^0.2.0",
    "@a2arium/callagent-utils": "^0.2.0",
    "@prisma/adapter-pg": "7.4.0",
    "@prisma/client": "7.4.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "prisma": "7.4.0",
    "ts-jest": "^29.3.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./generated": {
      "types": "./dist/generated/prisma/index.d.ts",
      "import": "./dist/generated/prisma/index.js",
      "default": "./dist/generated/prisma/index.js"
    }
  }
}
