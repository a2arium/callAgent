{
  "name": "@a2arium/callagent-runtime",
  "version": "0.1.0",
  "description": "Workspace runtime primitives for CallAgent.",
  "license": "MIT",
  "author": "A2arium <a2arium@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2arium/callAgent.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/a2arium/callAgent/issues"
  },
  "homepage": "https://github.com/a2arium/callAgent/tree/main/packages/runtime#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./host": {
      "import": "./dist/host.js",
      "types": "./dist/host.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-observer-assets.mjs",
    "npm:publish": "npm publish --access public",
    "npm:publish:dry-run": "npm publish --access public --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@a2arium/callagent-core": "^0.3.0",
    "@a2arium/callagent-driver-hatchet": "^0.1.0",
    "@a2arium/callagent-eventbus-nats": "^0.1.0",
    "@a2arium/callagent-memory-sql": "^0.2.0",
    "@a2arium/callagent-operator-auth": "^0.1.0",
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
