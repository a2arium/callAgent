{
  "name": "@a2arium/callagent-chat-bridge",
  "version": "0.1.0",
  "description": "Multi-network chat bridge for callagent: routing, session mapping, and replies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./generated": {
      "types": "./dist/generated/prisma/index.d.ts",
      "import": "./dist/generated/prisma/index.js",
      "default": "./dist/generated/prisma/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "yarn prisma:generate && tsc -p tsconfig.json && mkdir -p dist/generated/prisma && cp -R src/generated/prisma/* dist/generated/prisma/"
  },
  "keywords": [
    "chat",
    "telegram",
    "slack",
    "websocket",
    "serverless",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@a2arium/callagent-core": "workspace:*",
    "@a2arium/callagent-memory-sql": "workspace:*",
    "@a2arium/callagent-types": "workspace:*",
    "@a2arium/callagent-utils": "workspace:*",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "prisma": "^7.4.0",
    "typescript": "^5.8.3"
  }
}