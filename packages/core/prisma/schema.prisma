// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model AgentMemoryStore {
  key          String
  value        Json
  tags         String[]
  tenantId     String   @default("default") @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  blobData     Bytes?   @map("blob_data")
  blobMetadata Json?    @map("blob_metadata")

  @@id([tenantId, key])
  @@map("agent_memory_store")
}

model AgentResultCache {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  agentName String   @map("agent_name")
  cacheKey  String   @map("cache_key")
  result    Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@unique([tenantId, agentName, cacheKey])
  @@index([tenantId, agentName])
  @@index([expiresAt])
  @@map("agent_result_cache")
}

model Outbox {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  topic      String
  key        String
  payload    Json
  idempotencyKey String? @unique @map("idempotency_key")
  retryCount Int      @default(0) @map("retry_count")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, topic])
  @@map("outbox")
}

model DriverRun {
  id                String   @id @default(cuid())
  provider          String   @default("hatchet")
  providerRunId     String?  @unique @map("provider_run_id")
  providerTaskRunId String?  @map("provider_task_run_id")
  tenantId          String   @map("tenant_id")
  agentId           String?  @map("agent_id")
  taskId            String?  @map("task_id")
  token             String?
  traceId           String?  @map("trace_id")
  spanId            String?  @map("span_id")
  idempotencyKey    String?  @map("idempotency_key")
  operation         String
  status            String
  outboxRowId       String?  @map("outbox_row_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId, taskId])
  @@map("driver_runs")
}

model DurableSubscriptionCursor {
  tenantId       String   @map("tenant_id")
  streamId       String   @map("stream_id")
  consumerId     String   @map("consumer_id")
  sequenceNumber Int      @map("sequence_number")
  updatedAt      DateTime @map("updated_at")

  @@id([tenantId, streamId, consumerId])
  @@map("durable_subscription_cursors")
}

model ConversationDeadLetter {
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  sequenceNumber Int      @map("sequence_number")
  consumerId     String   @map("consumer_id")
  record         Json
  lastError      String   @map("last_error")
  attempts       Int
  deadletteredAt DateTime @map("deadlettered_at")

  @@id([tenantId, conversationId, sequenceNumber, consumerId])
  @@map("conversation_dead_letter")
}
