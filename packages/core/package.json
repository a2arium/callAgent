{
  "name": "@a2arium/callagent-core",
  "version": "0.2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./generated": {
      "types": "./dist/generated/prisma-client/index.d.ts",
      "import": "./dist/generated/prisma-client/index.js",
      "default": "./dist/generated/prisma-client/index.js"
    },
    "./unstable": {
      "types": "./dist/unstable.d.ts",
      "import": "./dist/unstable.js",
      "default": "./dist/unstable.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js",
      "default": "./dist/runner/index.js"
    },
    "./testing/contracts": {
      "types": "./dist/testing/contracts.d.ts",
      "import": "./dist/testing/contracts.js",
      "default": "./dist/testing/contracts.js"
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "rm -rf dist && yarn prisma:generate && tsc -p tsconfig.json && mkdir -p dist/generated/prisma-client && cp -R src/generated/prisma-client/* dist/generated/prisma-client/ && find dist/generated/prisma-client -name '*.ts' ! -name '*.d.ts' -delete",
    "test:types": "tsd . --files tests/*.test-d.ts",
    "npm:publish": "npm publish --access public",
    "npm:publish:dry-run": "npm publish --access public --dry-run",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Core framework for the CallAgent AI agent system.",
  "license": "MIT",
  "author": "A2arium <a2arium@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2arium/callAgent.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/a2arium/callAgent/issues"
  },
  "homepage": "https://github.com/a2arium/callAgent/tree/main/packages/core#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "core",
    "framework",
    "callagent"
  ],
  "bin": {
    "callagent-scaffold": "./dist/scaffold/scaffoldCli.js"
  },
  "dependencies": {
    "@a2arium/callagent-memory-engine": "^0.1.0",
    "@a2arium/callagent-memory-sql": "^0.2.0",
    "@a2arium/callagent-types": "^0.2.0",
    "@a2arium/callagent-utils": "^0.2.0",
    "@prisma/adapter-pg": "7.4.0",
    "@prisma/client": "7.4.0",
    "callllm": "^0.3.0",
    "dotenv": "^17.3.1",
    "pg": "8.13.3",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^7.4.0",
    "ts-jest": "^29.3.2",
    "tsd": "^0.33.0",
    "typescript": "^5.8.3"
  },
  "type": "module"
}
